# Copy to .env for local development, and set the same values in Vercel
# (Settings → Environment Variables → Production + Preview).
#
# Both have safe defaults in src/content/site.ts, so the site builds and runs
# without this file. Set them explicitly in production so the endpoint and the
# canonical host are configuration rather than hardcoded fallbacks.

# SoftInvites API base. The contact form POSTs to ${VITE_API_BASE}/contact.
VITE_API_BASE=https://292x833w13.execute-api.us-east-2.amazonaws.com

# Canonical origin for canonical tags, sitemap.xml and JSON-LD.
# No trailing slash. Must match the domain the site is actually served from.
VITE_SITE_ORIGIN=https://www.softinvite.com
